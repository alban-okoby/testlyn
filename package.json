{
  "name": "@alban225/testlyn",
  "version": "0.1.0",
  "description": "CLI-based API testing tool using YAML syntax. Write tests declaratively in YAML, run them with confidence.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "testlyn": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test tests/**/*.test.js",
    "dev": "node bin/cli.js --watch",
    "lint": "eslint src bin tests"
  },
  "keywords": [
    "api-testing",
    "yaml",
    "testing",
    "cli",
    "http",
    "integration-testing"
  ],
  "author": "Alban Okoby",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "yaml": "^2.3.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alban-okoby/testlyn.git"
  },
  "bugs": {
    "url": "https://github.com/alban-okoby/testlyn/issues"
  },
  "homepage": "https://github.com/alban-okoby/testlyn#readme"
}
